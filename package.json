{
  "name": "mollad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel:build": "prisma generate && npm run ocr:prepare && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "node scripts/e2e-production.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "tsx scripts/generate-icons.ts",
    "ocr:prepare": "tsx scripts/prepare-ocr.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx scripts/check-database.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "deepmerge-ts": "^8.0.0"
  }
}
